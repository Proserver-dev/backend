        "parameters": [
          {
            "name": "Device-Token",
            "in": "header",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "authPin": {
                  "type": "string",
                  "example": "123456"
                },
                "email": {
                  "type": "string",
                  "example": "john@doe.com"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Wszystko poszło GIT",
            "schema": {
              "type": "object",
              "properties": {
                "token": {
                  "type": "string",
                  "example": "string"
                },
                "refreshToken": {
                  "type": "string",
                  "example": "string"
                },
                "user": {
                  "$ref": "#/definitions/User"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "400": {
            "description": "Musisz przekazać wszystkie poprawne dane",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "ERR_PROVIDE_EMAIL_FIELD"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "401": {
            "description": "Kod do aktywacji konta jest niepoprawny",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "ERR_WRONG_AUTH_PIN"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "403": {
            "description": "Brakuje Device-Token w nagłówku lub jest nieprawidłowy",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "array",
                  "example": [
                    "ERR_PROVIDE_DEVICE_TOKEN",
                    "ERR_WRONG_DEVICE_TOKEN"
                  ],
                  "items": {
                    "type": "string"
                  }
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "404": {
            "description": "Taki email nie istnieje w bazie",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "ERR_USER_NOT_EXISTS"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "409": {
            "description": "Konto już jest aktywowane",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "ERR_USER_IS_ALREADY_ACTIVATED"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "422": {
            "description": "Nieprawidłowe dane wejściowe",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "ERR_INVALID_EMAIL_ADDRESS"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "423": {
            "description": "Logowanie wyłączone",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "ERR_LOGIN_DISABLED"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Błąd serwerowy",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "ERR_ACTIVATE_ACCOUNT_ERROR"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
