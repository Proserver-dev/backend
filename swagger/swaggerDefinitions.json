    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Endpoint do rejestracji",
        "description": "Endpoint do rejestracji",
        "parameters": [
          {
            "name": "Device-Token",
            "in": "header",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "example": "john@doe.com"
                },
                "password": {
                  "type": "string",
                  "example": "secret"
                },
                "userName": {
                  "type": "string",
                  "example": "johndoe123"
                },
                "nameLastname": {
                  "type": "string",
                  "example": "John Doe"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Wszystko poszło GIT",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "string",
                  "example": "SUCCESS_USER_REGISTERED"
                },
                "user": {
                  "$ref": "#/definitions/User"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "400": {
            "description": "Musisz przekazać wszystkie poprawne dane",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "array",
                  "example": [
                    "ERR_PROVIDE_EMAIL_FIELD",
                    "ERR_PROVIDE_PASSWORD_FIELD"
                  ],
                  "items": {
                    "type": "string"
                  }
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "403": {
            "description": "Brakuje Device-Token w nagłówku",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "ERR_PROVIDE_DEVICE_TOKEN"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "409": {
            "description": "Konflikt, taki user już istnieje",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "ERR_USER_ALREADY_EXISTS"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "422": {
            "description": "Nieprawidłowe dane wejściowe",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "ERR_INVALID_EMAIL_ADDRESS"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "423": {
            "description": "Rejestracja wyłączona",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "ERR_REGISTRATION_DISABLED"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Błąd serwerowy",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "ERR_REGISTER_ERROR"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "503": {
            "description": "Nie udało się wysłać maila z powodu niedostępności usługi pocztowej, ale konto się utworzyło",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "ERR_SEND_EMAIL"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/auth/activate": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Endpoint do aktywacji konta",
